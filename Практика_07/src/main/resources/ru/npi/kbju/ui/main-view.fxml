<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ru.npi.kbju.ui.MainController"
            prefWidth="1120" prefHeight="680" styleClass="app-root">
    <top>
        <VBox spacing="5" styleClass="header">
            <padding>
                <Insets top="22" right="24" bottom="18" left="24"/>
            </padding>
            <Label text="Дневник питания КБЖУ" styleClass="title"/>
            <Label text="Планы питания текущего сеанса" styleClass="subtitle"/>
            <Label fx:id="countLabel" text="Планов: 0" styleClass="counter"/>
        </VBox>
    </top>
    <center>
        <HBox spacing="18" fillHeight="true">
            <padding>
                <Insets top="18" right="24" bottom="24" left="24"/>
            </padding>
            <VBox spacing="10" HBox.hgrow="ALWAYS" minWidth="430">
                <Label text="Список планов" styleClass="section-title"/>
                <TableView fx:id="planTable" VBox.vgrow="ALWAYS"
                           minWidth="430" prefWidth="430" maxWidth="Infinity"
                           accessibleText="Таблица планов питания">
                    <placeholder>
                        <Label text="Планы питания ещё не добавлены"/>
                    </placeholder>
                    <columns>
                        <TableColumn fx:id="idColumn" text="ID" minWidth="55" prefWidth="65"
                                     maxWidth="85"/>
                        <TableColumn fx:id="nameColumn" text="Название плана" minWidth="170"
                                     prefWidth="250"/>
                        <TableColumn fx:id="dateColumn" text="Дата начала" minWidth="115"
                                     prefWidth="125"/>
                        <TableColumn fx:id="statusColumn" text="Состояние" minWidth="130"
                                     prefWidth="155"/>
                    </columns>
                </TableView>
            </VBox>
            <VBox fx:id="formPanel" spacing="10" HBox.hgrow="NEVER"
                  minWidth="300" prefWidth="310" maxWidth="350" styleClass="form-panel">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>
                <Label text="Новый план" styleClass="section-title"/>
                <Label text="Название, дата и состояние"
                       wrapText="true" styleClass="hint"/>

                <Label fx:id="nameLabel" text="_Название плана" mnemonicParsing="true"/>
                <TextField fx:id="nameField"
                           promptText="Например, поддержание массы"/>

                <Label fx:id="dateLabel" text="_Дата начала" mnemonicParsing="true"/>
                <DatePicker fx:id="effectiveFromPicker" editable="false" maxWidth="Infinity"/>

                <Label fx:id="statusLabel" text="_Состояние" mnemonicParsing="true"/>
                <ComboBox fx:id="statusBox" maxWidth="Infinity"/>

                <Button fx:id="addButton" text="Сохранить план" defaultButton="true"
                        onAction="#addPlan" maxWidth="Infinity" styleClass="primary-button"/>

                <Separator/>
                <Label text="Действия с выбранной строкой" styleClass="section-subtitle"/>
                <Button fx:id="activateButton" text="Сделать активным"
                        onAction="#activateSelectedPlan" maxWidth="Infinity"/>
                <Button fx:id="removeButton" text="Удалить выбранный"
                        onAction="#removeSelectedPlan" maxWidth="Infinity"
                        styleClass="danger-button"/>
                <Label fx:id="messageLabel" text="Загрузка формы…" wrapText="true"
                       styleClass="message-label"/>
            </VBox>
        </HBox>
    </center>
</BorderPane>
